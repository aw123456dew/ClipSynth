}

#genSettingsSpin {
    background-color: #0a0f1a;
    color: #e2e8f0;
    border: 1px solid #2a3a5a;
    border-radius: 6px;
    font-size: 14px;
    padding: 4px 10px;
}

#genSettingsSpin:focus {
    border-color: #6366f1;
}

#genSettingsSpin::up-button, #genSettingsSpin::down-button {
    width: 16px;
    background-color: #1a2340;
    border: none;
}

#genSettingsSpin::up-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #94a3b8;
    margin-bottom: 1px;
}

#genSettingsSpin::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #94a3b8;
    margin-top: 1px;
}

#genSettingsSpin::up-button:hover, #genSettingsSpin::down-button:hover {
    background-color: #0d1f3c;
}

#genSettingsCombo {
    background-color: #0a0f1a;
    color: #e2e8f0;
    border: 1px solid #2a3a5a;
    border-radius: 6px;
    font-size: 14px;
    padding: 4px 10px;
}

#genSettingsCombo:hover {
    border-color: #4fc3f7;
}

#genSettingsCombo:editable {
    background-color: #0a0f1a;
}

#genSettingsCombo QAbstractItemView {
    background-color: #0f172a;
    color: #e2e8f0;
    border: 1px solid #2a3a5a;
    border-radius: 6px;
    selection-background-color: #1e3a5f;
    selection-color: #4fc3f7;
    outline: none;
    padding: 4px;
}

#genSettingsCombo QAbstractItemView::item {
    min-height: 30px;
    padding: 6px 12px;
    border-radius: 4px;
    color: #cbd5e1;
    background-color: transparent;
}

#genSettingsCombo QAbstractItemView::item:hover {
    background-color: #182545;
    color: #e2e8f0;
}

#genSettingsCombo QAbstractItemView::item:selected {
    background-color: #1e3a5f;
    color: #4fc3f7;
    font-weight: bold;
}

#genSettingsCombo::drop-down {
    border: none;
    width: 20px;
}

#genSettingsCombo::down-arrow {
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #94a3b8;
    margin-right: 4px;
}

#genSettingsPrefixEdit {
    background-color: #0a0f1a;
    color: #e2e8f0;
    border: 1px solid #2a3a5a;
    border-radius: 8px;
    font-size: 13px;
    padding: 10px;
    selection-background-color: #6366f1;
}

#genSettingsPrefixEdit:focus {
    border-color: #6366f1;
}

#imageTestDialog {
    background-color: #0d111f;
    border: 1px solid #1a2340;
    border-radius: 12px;
}

#imagePreviewDialog {
    background-color: #0d111f;
    border: 1px solid #1a2340;
    border-radius: 12px;
}

#imagePreviewScroll {
    background-color: #0a0f1a;
    border: none;
}

/* ===== Dub Mode Dialog ===== */
#dubModeDialog {
    background-color: #0d111f;
    border: 1px solid #1a2340;
    border-radius: 12px;
}

#dubModeCard {
    background-color: #0c1322;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 20px;
}

#dubModeCard:hover {
    background-color: #111827;
    border-color: #6366f1;
}

#dubModeCardTitle {
    color: #e2e8f0;
    font-size: 15px;
    font-weight: 700;
}

#dubModeCardDesc {
    color: #64748b;
    font-size: 12px;
}

#previewCloseBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #818cf8);
}

#removeSubtitleTipsLabel {
    color: #64748b;
    font-size: 12px;
}

/* ===== Subtitle Preview Dialog ===== */
#subtitlePreviewDialog {
    background-color: #0a0e17;
}

#previewLeftPanel {
    background-color: #0a0e17;
}

#previewFrame {
    background-color: #060a12;
    border: 1px solid #1a2340;
    border-radius: 8px;
    min-height: 360px;
}

#previewTimeSlider::groove:horizontal {
    background-color: #1a2340;
    height: 6px;
    border-radius: 3px;
}

#previewTimeSlider::handle:horizontal {
    background-color: #6366f1;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

#previewTimeSlider::handle:horizontal:hover {
    background-color: #818cf8;
}

#previewTimeSlider::sub-page:horizontal {
    background-color: #4f46e5;
    height: 6px;
    border-radius: 3px;
}

#previewTimeLabel {
    color: #94a3b8;
    font-size: 13px;
    font-family: "Consolas", "Courier New", monospace;
    font-weight: 600;
}

#previewRightPanel {
    background-color: #0d111f;
    border-left: 1px solid #1a2340;
}

#previewRightContent {
    background-color: #0d111f;
}

#previewSettingsTitle {
    color: #e2e8f0;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding-bottom: 4px;
}

#previewTextCombo, #previewFontCombo, #previewSizeCombo, #previewPosCombo {
    background-color: #0a0f1a;
    color: #e2e8f0;
    font-size: 13px;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 24px;
}

#previewTextCombo:hover, #previewFontCombo:hover, #previewSizeCombo:hover, #previewPosCombo:hover {
    border-color: #6366f1;
}

#previewTextCombo QAbstractItemView, #previewFontCombo QAbstractItemView, #previewSizeCombo QAbstractItemView, #previewPosCombo QAbstractItemView {
    background-color: #0d111f;
    color: #e2e8f0;
    font-size: 13px;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

#previewTextCombo QAbstractItemView::item, #previewFontCombo QAbstractItemView::item, #previewSizeCombo QAbstractItemView::item, #previewPosCombo QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
}

#previewTextCombo QAbstractItemView::item:hover, #previewFontCombo QAbstractItemView::item:hover, #previewSizeCombo QAbstractItemView::item:hover, #previewPosCombo QAbstractItemView::item:hover {
    background-color: #1a2744;
    color: #60a5fa;
}

#previewFgColorBtn, #previewBgColorBtn {
    border: 2px solid #1e293b;
    border-radius: 6px;
    min-width: 32px;
    min-height: 32px;
    max-width: 32px;
    max-height: 32px;
}

#previewFgColorBtn:hover, #previewBgColorBtn:hover {
    border-color: #6366f1;
}

#previewOpacitySlider {
    background-color: transparent;
}

#previewOpacitySlider::groove:horizontal {
    background-color: #1a2340;
    height: 6px;
    border-radius: 3px;
}

#previewOpacitySlider::handle:horizontal {
    background-color: #6366f1;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

#previewOpacitySlider::handle:horizontal:hover {
    background-color: #818cf8;
}

#previewOpacitySlider::sub-page:horizontal {
    background-color: #4f46e5;
    height: 6px;
    border-radius: 3px;
}

#previewCloseBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4f46e5, stop:1 #6366f1);
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    min-height: 20px;
    margin-top: 8px;
}

#previewCloseBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #818cf8);
}

#previewCloseBtn:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4338ca, stop:1 #4f46e5);
}

#previewHintLabel {
    color: #4a5a7a;
    font-size: 12px;
    padding: 4px 8px;
}

/* ===== Custom Voiceover List ===== */
#mergeVoiceoverBtn {
    background-color: #1a2744;
    color: #60a5fa;
    border: 1px solid #3b82f6;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
    min-height: 20px;
}

#mergeVoiceoverBtn:hover {
    background-color: #1e3050;
    border-color: #60a5fa;
    color: #93bbfc;
}

#mergeVoiceoverBtn:pressed {
    background-color: #15203a;
}

#mergeVoiceoverBtn:disabled {
    background-color: #0f1520;
    color: #4a5a7a;
    border-color: #1e293b;
}

#exportVoiceoverBtn {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
    min-height: 20px;
}

#exportVoiceoverBtn:hover {
    background-color: #1a2744;
    color: #e2e8f0;
    border-color: #6366f1;
}

#exportVoiceoverBtn:pressed {
    background-color: #15203a;
}

#customVoiceoverTable {
    background-color: #0f1320;
    color: #c8d6e5;
    border: 1px solid #1e293b;
    border-radius: 8px;
    gridline-color: #1a2340;
    font-size: 13px;
}

#customVoiceoverTable::item {
    padding: 6px 10px;
    border-bottom: 1px solid #1a2340;
}

#customVoiceoverTable::item:selected {
    background-color: #1a2744;
    color: #60a5fa;
}

#customVoiceoverTable QHeaderView::section {
    background-color: #0d111f;
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #1e293b;
}

#uploadAudioBtn, #uploadSubtitleBtn {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 600;
}

#uploadAudioBtn:hover, #uploadSubtitleBtn:hover {
    background-color: #1a2744;
    color: #e2e8f0;
    border-color: #6366f1;
}

#uploadAudioBtn:pressed, #uploadSubtitleBtn:pressed {
    background-color: #15203a;
}

#uploadAudioBtn {
    color: #60a5fa;
    border-color: #3b82f6;
}

#uploadSubtitleBtn {
    color: #a78bfa;
    border-color: #8b5cf6;
}


/* ===== Recognition Progress Bar ===== */
#recognitionProgressBar {
    background-color: #0a0f1a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    text-align: center;
    color: #e2e8f0;
    font-size: 12px;
    min-height: 24px;
    max-height: 24px;
}

#recognitionProgressBar::chunk {
    background-color: #3b82f6;
    border-radius: 5px;
}

/* ===== Speaker Cards (Character Recognition V2) ===== */
#speakerCard {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#speakerCardHeader {
    background-color: transparent;
}

#speakerAliasInput {
    background-color: #0a0f1a;
    color: #e2e8f0;
    border: 1px solid #1e293b;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
    min-height: 22px;
}

#speakerAliasInput:focus {
    border-color: #6366f1;
}

#speakerAliasInput:hover {
    border-color: #475569;
}

#speakerTextList {
    background-color: transparent;
    color: #e2e8f0;
    font-size: 13px;
    border: none;
    padding: 0 8px 8px 8px;
    outline: none;
}

#speakerTextList::item {
    border-bottom: 1px solid #1a2744;
    padding: 4px 0;
}

#speakerTextList::item:hover {
    background-color: #1a1f2e;
    border-radius: 6px;
}

#speakerTextItem {
    background-color: transparent;
    border-radius: 6px;
    min-height: 36px;
}

#speakerTextItem:hover {
    background-color: #1a1f2e;
}

#speakerTextEdit {
    color: #e2e8f0;
    font-size: 13px;
    background: transparent;
    border: none;
    padding: 2px 4px;
}

#speakerTextEdit:focus {
    background-color: #1a1f2e;
    border: 1px solid #6366f1;
    border-radius: 4px;
}

#segmentPreviewBtn {
    background-color: #1e293b;
    color: #60a5fa;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
    min-width: 50px;
}

#segmentPreviewBtn:hover {
    background-color: #1a2744;
    border-color: #6366f1;
}

#addSpeakerBtn {
    background-color: #1a2744;
    color: #60a5fa;
    border: 1px dashed #3b82f6;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
}

#addSpeakerBtn:hover {
    background-color: #1e3050;
    border-color: #6366f1;
    color: #93c5fd;
}

#roleAliasPopup {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#roleAliasBtn {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 14px;
    padding: 4px 14px;
    font-size: 12px;
    min-height: 22px;
}

#roleAliasBtn:hover {
    background-color: #1a2744;
    border-color: #6366f1;
    color: #ffffff;
}

/* ===== Generate Script Page (V2) ===== */
#scriptInputPanel {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 10px;
    padding: 16px;
}

#scriptConfigPanel {
    background-color: transparent;
}

#scriptTextEdit, #scriptRequirementEdit {
    background-color: #0a0f1a;
    color: #e2e8f0;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 13px;
    selection-background-color: #1a3a6b;
}

#scriptTextEdit:focus, #scriptRequirementEdit:focus {
    border-color: #6366f1;
}

/* ===== Video Preview Dialog ===== */
#videoPreviewDialog {
    background-color: #0a0f1a;
}

#previewVideoWidget {
    background-color: #000000;
    border: 1px solid #1e293b;
    border-radius: 8px;
}

#previewControlBtn {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 6px 14px;
    font-size: 12px;
    min-width: 60px;
}

#previewControlBtn:hover {
    background-color: #1a2744;
    border-color: #6366f1;
}

#previewSlider {
    background-color: transparent;
    min-height: 16px;
}

#previewSlider::groove:horizontal {
    background-color: #1a2340;
    height: 6px;
    border-radius: 3px;
}

#previewSlider::handle:horizontal {
    background-color: #6366f1;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

#previewSlider::sub-page:horizontal {
    background-color: #3b82f6;
    height: 6px;
    border-radius: 3px;
}

#generateScriptBtn {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
    min-height: 20px;
}

#generateScriptBtn:hover {
    background-color: #2563eb;
}

#generateScriptBtn:pressed {
    background-color: #1d4ed8;
}

#generateScriptBtn:disabled {
    background-color: #1e293b;
    color: #64748b;
}
