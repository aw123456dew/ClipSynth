#removeSubtitleEnableBtn:hover {
    background-color: #1a2744;
    color: #e2e8f0;
    border-color: #6366f1;
}

#removeSubtitleEnableBtn:checked {
    background-color: #1a2744;
    border-color: #6366f1;
    color: #a5b4fc;
}

#removeSubtitlePreviewBtn {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
