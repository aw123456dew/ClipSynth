    background-color: #0c1322;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#selfAudioGroup::title {
    color: #e2e8f0;
    font-size: 14px;
    font-weight: 700;
}

#selfSubtitleGroup {
    background-color: #0c1322;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#selfSubtitleGroup::title {
    color: #e2e8f0;
    font-size: 14px;
    font-weight: 700;
}

#uploadAudioBtn, #uploadSubtitleBtn {
    background-color: #1e293b;
    color: #a5b4fc;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 600;
}

#uploadAudioBtn:hover, #uploadSubtitleBtn:hover {
    background-color: #312e81;
    color: #e0e7ff;
    border-color: #6366f1;
}

#orientationGroup, #subtitleSettingsGroup {
    background-color: #0c1322;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#orientationGroup::title, #subtitleSettingsGroup::title {
    color: #e2e8f0;
    font-size: 14px;
    font-weight: 700;
}

#ratioCombo {
    background-color: #0a0f1a;
    color: #e2e8f0;
    border: 1px solid #1e293b;
    border-radius: 8px;
    font-size: 13px;
    padding: 8px 14px;
    min-height: 20px;
}

#ratioCombo:hover {
    border-color: #6366f1;
}

#ratioCombo:focus {
    border-color: #6366f1;
    background-color: #0c1322;
}

#ratioCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border: none;
}

#ratioCombo::down-arrow {
    image: none;
    border: none;
}

#ratioCombo QAbstractItemView {
    background-color: #0d111f;
    color: #e2e8f0;
    font-size: 13px;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

#ratioCombo QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
}

#ratioCombo QAbstractItemView::item:hover {
    background-color: #1a2744;
    color: #60a5fa;
}

#ratioCombo QAbstractItemView::item:selected {
    background-color: #1a2744;
    color: #60a5fa;
}

